---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookCard from '../../components/BookCard.astro';
import { getBooks } from '../../lib/notion';

const books = await getBooks();
---

<BaseLayout title="Books | Abubakar Abdullahi" description="Books I'm reading and recommending">
  <Header showHero={false} />
  <main role="main">
    <section class="page-header">
      <div class="row">
        <h1>Books</h1>
        <p>What I'm reading.</p>
      </div>
    </section>
    <section>
      <div class="row">
        {
          books.length === 0 ? (
            <p class="empty-state">
              No books yet. Add published entries in the Notion Books database and rebuild.
            </p>
          ) : (
            <div class="books-grid">
              {books.map((book) => (
                <BookCard book={book} />
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

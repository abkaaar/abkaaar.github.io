---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/notion';

const projects = await getProjects();
const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <Header />
  <main role="main">
    <section class="work" id="work">
      <div class="row">
        <h2>Projects</h2>
        <p>Projects I've have worked on:</p>
        <div class="work__boxes">
          {featured.map((project) => <ProjectCard project={project} />)}

          {
            more.length > 0 && (
              <div class="more__work-container">
                <div class="work__btn-container">
                  <button class="work__button btn" id="load-more">
                    More Projects <span>&rarr;</span>
                  </button>
                </div>
                <div class="more__work">
                  {more.map((project) => (
                    <ProjectCard project={project} />
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="client" id="clients">
      <div class="row">
        <h2>Technologies</h2>
        <div class="client__logos">
          <img src={`${base}Images/js.png`} class="client__logo" alt="JavaScript" />
          <img src={`${base}Images/nextjs.png`} class="client__logo" alt="Next.js" />
          <img src={`${base}Images/java.png`} class="client__logo" alt="Java" />
          <img src={`${base}Images/react.png`} class="client__logo" alt="React" />
          <img src={`${base}Images/aws.png`} class="client__logo" alt="AWS" />
          <img src={`${base}Images/android-studio.png`} class="client__logo" alt="Android Studio" />
          <img src={`${base}Images/firebase.png`} class="client__logo" alt="Firebase" />
          <img src={`${base}Images/kotlin.png`} class="client__logo" alt="Kotlin" />
          <img src={`${base}Images/expo.png`} class="client__logo" alt="Expo" />
        </div>
      </div>
    </section>

    <section class="about" id="about">
      <div class="row">
        <h2>About Me</h2>
        <div class="about__content">
          <div class="about__text">
            <p>
              Hi, my name is Abubakar Abdullahi. I am a software engineer with a strong
              background in building modern digital products at scale and a proven track
              record of leveraging technology to help teams and clients achieve their goals.
              <br /><br />
              I am currently conducting MSc research at the intersection of software
              engineering, architecture & integrity, and artificial intelligence. My present
              focus is on developing digital infrastructures for food businesses.
              <br /><br />
              I thrive on creativity, problem‑solving, and driving meaningful impact. Let’s
              connect!
            </p>
            <a href="mailto:abkaaar2@gmail.com" class="btn">abkaaar2@gmail.com</a>
          </div>
          <div class="about__photo-container">
            <img class="about__photo" src={`${base}Images/mypic.jpg`} alt="Abubakar Abdullahi" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

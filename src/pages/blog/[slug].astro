---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts } from '../../lib/notion';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const dateLabel = post.date
  ? new Date(post.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={`${post.name} | Abubakar Abdullahi`} description={post.summary || post.name}>
  <Header showHero={false} />
  <main role="main">
    <article class="page-header">
      <div class="row">
        <p class="content-meta">
          <a href={`${base}blog/`}>Blog</a>
        </p>
        <h1>{post.name}</h1>
        {dateLabel && <p class="content-meta">{dateLabel}</p>}
        {post.summary && <p>{post.summary}</p>}
        {
          post.coverUrl && (
            <img src={post.coverUrl} alt="" style="margin-top: 2rem; max-width: 100%;" />
          )
        }
        <div class="prose" set:html={post.contentHtml} />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

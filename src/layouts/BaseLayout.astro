---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Abubakar Abdullahi | Software Engineer.',
  description = 'Abubakar Abdullahi - Software Engineer',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/png" href={`${base}Images/favicon.png`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Software Engineer, Solution Architect, Data analytics, Project Management, Instructional Design, Learning & Development Expert"
    />
  </head>
  <body>
    <slot />
    <a href="#top" class="back-to-top" title="Back to Top">
      <img
        src={`${base}Images/arrow-up.svg`}
        alt="Back to Top"
        class="back-to-top__image"
      />
    </a>
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>

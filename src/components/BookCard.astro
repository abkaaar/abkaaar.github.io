---
import type { Book } from '../lib/types';

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<article class="book-card">
  {
    book.coverUrl ? (
      <img src={book.coverUrl} class="book-card__cover" alt={`Cover of ${book.name}`} />
    ) : (
      <div class="book-card__cover" aria-hidden="true" />
    )
  }
  <span class="book-card__status">{book.status}</span>
  <h3>{book.name}</h3>
  {book.author && <p class="content-meta">{book.author}</p>}
  {book.notes && <p>{book.notes}</p>}
</article>
